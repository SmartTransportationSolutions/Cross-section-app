# -----------------------------------------------------------------------------
# STS Street configuration.
# Copy to `.env` (ignored by Git) and fill in values. Never commit secrets.
# Full reference: docs/operations.md
# -----------------------------------------------------------------------------

NODE_ENV=development

# Public address of this deployment. Used for absolute links, auth callbacks,
# token issuer and social preview images.
# APP_DOMAIN=street.sts.com.ge
# APP_PROTOCOL=https
# PORT=8000
# Set when running behind a reverse proxy / load balancer (Docker, nginx).
# TRUST_PROXY=true

# --- Database (PostgreSQL 14+ with PostGIS) --------------------------------
# Either DATABASE_URL or the PG* variables.
# DATABASE_URL=postgres://user:password@host:5432/sts_street
PGUSER=streetmix
PGPASSWORD=streetmix
PGDATABASE=sts_street_dev
PGHOST=127.0.0.1
PGPORT=5432

# --- Secrets (required in production) --------------------------------------
# Signs the short-lived server session cookie. Generate: openssl rand -hex 32
COOKIE_SESSION_SECRET=
# RSA private key (PKCS#8 PEM) that signs sign-in tokens.
# Generate with: npm run auth:generate-key  (writes ./data/auth-key.pem)
# Either inline (newlines escaped as \n) or a file path.
# AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PRIVATE_KEY_FILE=./data/auth-key.pem

# --- Identity service (built in) --------------------------------------------
# AUTH_ISSUER=https://street.sts.com.ge/
# AUTH_AUDIENCE=sts-street
# AUTH_PASSWORD_MIN_LENGTH=10
# AUTH_SIGN_UP=true
# Credential attempts per 15 min per IP (default 20; raise for load tests)
# AUTH_RATE_LIMIT_MAX=20
# AUTH_EMAIL_RATE_LIMIT_MAX=8
# Optional federated sign-in through any OpenID Connect provider. Repeat the
# block for each provider; <NAME> becomes the provider key (e.g. GOOGLE -> google).
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# OIDC_GOOGLE_ISSUER=https://accounts.google.com
# OIDC_GOOGLE_LABEL=Google

# --- Email (magic links, password resets) -----------------------------------
# MAIL_TRANSPORT=smtp | outbox | none   (default: smtp if SMTP_* set, else
#                                        outbox in development, none in production)
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="STS Street <no-reply@sts.com.ge>"
# MAIL_OUTBOX_DIR=./data/mail-outbox

# --- Maps and geocoding (Location dialog) -----------------------------------
# Pelias-compatible geocoder (e.g. https://geocode.earth, or a self-hosted Pelias).
# Without a key, address search is disabled and the map still works.
# PELIAS_HOST_NAME=api.geocode.earth
# PELIAS_API_KEY=
# Raster tile template. Default: OpenStreetMap standard tiles (subject to the
# OSM tile usage policy; use a commercial provider for production traffic).
# MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILES_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# --- Optional operator services ---------------------------------------------
# Error reporting (browser). Leave empty to disable.
# SENTRY_DSN=
# Privacy-friendly analytics (Plausible). Leave empty to disable.
# PLAUSIBLE_ID=
# PLAUSIBLE_HOST=plausible.io
# Facebook app id for share dialogs (optional).
# FACEBOOK_APP_ID=
# Translation management (optional; translations are bundled in the repo).
# TRANSIFEX_API_TOKEN=
# Notification banner shown above the editor, JSON. See client/src/app/NotificationBar.
# SPONSOR_BANNER=

# --- Misc -------------------------------------------------------------------
# IMAGE_CACHE_DIR=./data/image-cache
# SOURCE_COMMIT=   (set by the Docker build; identifies the running source)
# DEBUG=false
# OFFLINE_MODE=false
