<!DOCTYPE html>
<html lang="en">
  <head>
    <title>{{brand.productName}}</title>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Language" content="en" />
    {{! Display at 75% on mobile devices only; should not affect desktop browsers }}
    <meta
      name="viewport"
      content="width=device-width, initial-scale=.75, maximum-scale=1"
    />

    <meta name="title" content="{{STREETMIX_TITLE}}" />
    <meta name="description" content="{{STREETMIX_DESCRIPTION}}" />
    <meta name="application-name" content="{{brand.productName}}" />
    <meta name="generator" content="{{brand.productName}} (based on Streetmix)" />
    <link rel="canonical" href="{{STREETMIX_URL}}" />

    {{! Preview content for search engines, social media, chat apps }}
    {{! Open Graph / Facebook }}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{brand.productName}}" />
    <meta property="og:url" content="{{STREETMIX_URL}}" />
    <meta property="og:title" content="{{STREETMIX_TITLE}}" />
    <meta property="og:description" content="{{STREETMIX_DESCRIPTION}}" />
    <meta property="og:image" content="{{STREETMIX_IMAGE.image}}" />
    {{#if STREETMIX_IMAGE.width}}
    <meta property="og:image:width" content="{{STREETMIX_IMAGE.width}}" />
    <meta property="og:image:height" content="{{STREETMIX_IMAGE.height}}" />
    {{/if}}

    {{! Facebook }}
    {{#if env.FACEBOOK_APP_ID}}
    <meta property="fb:app_id" content="{{env.FACEBOOK_APP_ID}}" />
    {{/if}}

    {{! Twitter }}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="{{STREETMIX_URL}}" />
    <meta property="twitter:title" content="{{STREETMIX_TITLE}}" />
    <meta property="twitter:description" content="{{STREETMIX_DESCRIPTION}}" />
    <meta property="twitter:image" content="{{STREETMIX_IMAGE.image}}" />

    {{! Favicons (STS Street brand assets, see bin/generate-brand-assets.mjs) }}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=sts1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=sts1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=sts1" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=sts1" />
    <link rel="manifest" href="/site.webmanifest?v=sts1" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg?v=sts1" color="{{brand.themeColor}}" />
    <link rel="shortcut icon" href="/favicon.ico?v=sts1" />
    <meta name="apple-mobile-web-app-title" content="{{brand.productName}}" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="transparent" />
    <meta name="msapplication-TileColor" content="{{brand.tileColor}}" />
    <meta name="theme-color" content="{{brand.themeColor}}" />

    {{! Styles }}
    <link href="/assets/main.{{cacheTimestamp}}.css" rel="stylesheet" />

    {{! Optional, operator-configured privacy-friendly analytics (Plausible) }}
    {{#if env.PLAUSIBLE_ID}}
    <script async src="https://{{env.PLAUSIBLE_HOST}}/js/{{env.PLAUSIBLE_ID}}.js"></script>
    <script nonce="{{nonces.plausible}}">
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
    {{/if}}
  </head>
  <body tabindex="1">

    {{! SVG staging area }}
    <div id="svg"></div>

    {{! Mount point for React }}
    <div id="react-app" class="app"></div>
    <noscript>To use {{brand.productName}},&nbsp;<a href="https://www.enable-javascript.com/">please enable JavaScript</a>.</noscript>

    {{! Legal and source links, also visible to crawlers }}
    <section class="privacy-link">
      <a href="{{brand.privacyPolicyUrl}}" target="_blank">Privacy policy</a>
      <a href="{{brand.termsOfServiceUrl}}" target="_blank">Terms of service</a>
      <a href="{{brand.sourceUrl}}" target="_blank">Source code</a>
    </section>

    <script src="/assets/main.{{cacheTimestamp}}.js" type="module"></script>
  </body>
</html>
