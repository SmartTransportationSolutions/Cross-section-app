<!DOCTYPE html>
<html lang="en">
  <head>
    <title>{{pageTitle}} – {{brand.productName}}</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="{{brand.themeColor}}" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=sts1" />
    <link href="/favicon.ico?v=sts1" rel="shortcut icon" />
    <link href="/assets/main.{{cacheTimestamp}}.css" rel="stylesheet" />
    <style>
      .sts-page { max-width: 760px; margin: 0 auto; padding: 32px 20px 64px; font-family: var(--font-family, sans-serif); color: #1d2a3a; line-height: 1.55; }
      .sts-page header { display: flex; align-items: center; gap: 14px; padding-bottom: 16px; margin-bottom: 24px; border-bottom: 3px solid {{brand.themeColor}}; }
      .sts-page header img { height: 36px; }
      .sts-page header a { color: inherit; text-decoration: none; font-weight: 600; }
      .sts-page h1 { font-size: 1.9rem; margin: 0 0 0.5em; font-weight: 600; }
      .sts-page h2 { font-size: 1.25rem; margin: 1.6em 0 0.4em; font-weight: 600; }
      .sts-page a { color: {{brand.themeColor}}; }
      .sts-page code { background: #eef2f6; padding: 0 4px; border-radius: 3px; }
      .sts-page footer { margin-top: 48px; padding-top: 16px; border-top: 1px solid #dfe5ec; font-size: 0.9rem; color: #5b6b7c; }
      .sts-page .sts-notice { background: #fff8e5; border-left: 4px solid #f2a900; padding: 12px 16px; border-radius: 4px; }
      .sts-page .btn { display: inline-block; }
      .sts-page dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 18px; }
      .sts-page dt { font-weight: 600; }
    </style>
  </head>
  <body>
    <main class="sts-page">
      <header>
        <a href="/"><img src="/images/logo_horizontal.svg" alt="{{brand.productName}}" /></a>
      </header>
